{
  "expo": {
    "name": "TechService",
    "slug": "TechService",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbXpfAA5zNJWLK2VKjsj1OGOovT3VopSo"
        }
      },
      "package": "com.techservice.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.techservice.app",
      "config":{
        "googleMapsApiKey": "AIzaSyBXzz9L7j1-PEHNpDjCAAEFV29MsD9URAM"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o aplicativo utilize a câmera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o aplicativo acesse suas fotos.",
          "savePhotosPermission": "Permita que o aplicativo salve fotos na galeria.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e38361e-d679-4a41-b9a8-2255d8f6c2b1"
      }
    }
  }
}
